+Future<void> checkFanoosUpdate() async {
+  const installed = __FANOOS_BUILD_NUMBER__;
+  if (installed == 0 || !mainGetLocalBoolOptionSync(kOptionEnableCheckUpdate)) return;
+  final platform = isWindows ? 'windows' : 'jetson';
+  final tagPattern = RegExp('^client-' + platform + r'-build-([0-9]+)$');
+  try {
+    final response = await http.HttpService().sendRequest(
+        Uri.https('api.github.com', '/repos/ehsanark/fanoosdesk/releases',
+            {'per_page': '100'}), http.HttpMethod.get);
+    if (response.statusCode != 200) return;
+    var latest = installed;
+    for (final release in jsonDecode(response.body) as List) {
+      if (release['draft'] == true) continue;
+      final match = tagPattern.firstMatch(release['tag_name'] as String);
+      if (match == null) continue;
+      final build = int.tryParse(match.group(1)!) ?? 0;
+      final filename = isWindows ? 'FanoosDesk-Client-Windows-x64.exe' :
+          'FanoosDesk-Client-Jetson-Orin-Nano-arm64.deb';
+      if (build > latest && (release['assets'] as List).any((a) => a['name'] == filename)) {
+        latest = build;
+      }
+    }
+    if (latest > installed) {
+      stateGlobal.updateUrl.value =
+          'https://github.com/ehsanark/fanoosdesk/releases/tag/client-$platform-build-$latest';
+    }
+  } catch (e) {
+    debugPrint('Fanoos release check: $e');
+  }
+}
